{
  "functions": {
    "api/analyst.js": { "maxDuration": 60 },
    "api/warn.js": { "maxDuration": 60 },
    "api/hindcast.js": { "maxDuration": 60 },
    "api/cron-warn.js": { "maxDuration": 60 },
    "api/pilot-data.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-warn", "schedule": "0 1 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
